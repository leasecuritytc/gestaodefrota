# Copie para .env e preencha os valores reais. NUNCA commite o .env.

# ---- Banco: usuário administrativo (só usado nas migrations/initdb) ----
POSTGRES_DB=gestaodefrota
POSTGRES_USER=gdf_admin
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_1

# ---- Banco: usuário da aplicação (sem privilégio de superusuário; sujeito à RLS) ----
APP_DB_USER=gdf_app
APP_DB_PASSWORD=TROQUE_POR_SENHA_FORTE_2

# String de conexão que a API usa de fato (host = nome do serviço docker "db")
DATABASE_URL=postgresql://gdf_app:TROQUE_POR_SENHA_FORTE_2@db:5432/gestaodefrota

# Segredo para assinar os tokens JWT de sessão (gere com: openssl rand -hex 64)
JWT_SECRET=TROQUE_POR_UM_VALOR_ALEATORIO_DE_128_CARACTERES

# Porta interna da API dentro do container (não precisa mudar)
PORT=4000

# Origem permitida para o frontend (CORS)
CORS_ORIGIN=https://alexander-log.com.br

# URL base usada para montar os links de convite/redefinicao de senha
# enviados por e-mail (ex.: https://alexander-log.com.br/ativar-conta?token=...).
# Enquanto o frontend nao existir, o token continua valido via chamada
# direta a API — ver README, secao "Cadastro de usuarios e recuperacao de senha".
FRONTEND_BASE_URL=https://alexander-log.com.br

# --- E-mail (SMTP) para convite de ativacao e "esqueci minha senha" ---
# Preencher quando tiver uma conta SMTP (Gmail/Workspace, SendGrid, etc.).
# Ver README, secao "Ativando o envio de e-mail", para o passo a passo.
# Sem isso preenchido, os links aparecem no log do servidor (docker compose
# logs -f api) em vez de ir por e-mail — nunca falha silenciosamente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Mercado Livre API (preencher quando as credenciais chegarem) ---
ML_API_BASE_URL=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# --- VEC Fleet (portal do Mercado Livre) ---
# Login do portal https://meli-br.vecfleet.io. Preencha SÓ no servidor,
# entre aspas simples. Nunca commitar valores reais.
VEC_USUARIO=
VEC_SENHA=
# Opcionais:
VEC_API_BASE_URL=
VEC_API_TOKEN=
VEC_SYNC_INTERVALO_MIN=120

# --- Google Sheets (preencher quando a service account for criada e autorizada) ---
# Ver README, secao "Ativando o Google Sheets de verdade", para o passo a passo.
# IDs das planilhas (o trecho entre /d/ e /edit na URL), separados por virgula
# se houver mais de uma (ex.: uma por base).
GOOGLE_SHEETS_SPREADSHEET_IDS=
# Conteudo INTEIRO do arquivo JSON da service account, numa linha so, entre
# aspas simples (ex.: GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}')
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
